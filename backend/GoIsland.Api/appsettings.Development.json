{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "GoIsland.Api",
    "Audience": "GoIsland.Client"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Email": {
    "Provider": "Smtp",
    "FromEmail": "no-reply@goisland.example",
    "FromName": "GoIsland",
    "ResetPasswordUrl": "http://localhost:5173/reset-password"
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true
  },
  "Payments": {
    "Provider": "Mock",
    "Currency": "USD",
    "ServiceFeePercent": 5,
    "CommissionPercent": 12
  },
  "Cors": {
    "FrontendUrl": "http://localhost:5173"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
