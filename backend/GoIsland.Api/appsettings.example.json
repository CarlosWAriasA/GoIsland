{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
  },
  "Jwt": {
    "Issuer": "GoIsland.Api",
    "Audience": "GoIsland.Client",
    "Key": "set-with-user-secrets-or-Jwt__Key"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "GoogleAuth": {
    "ClientId": "your-client-id.apps.googleusercontent.com"
  },
  "Email": {
    "Provider": "Smtp",
    "FromEmail": "no-reply@goisland.example",
    "FromName": "GoIsland",
    "ResetPasswordUrl": "http://localhost:5173/reset-password"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "set-with-user-secrets-or-Smtp__Username",
    "Password": "set-with-user-secrets-or-Smtp__Password"
  },
  "Resend": {
    "ApiKey": "set-with-user-secrets-or-Resend__ApiKey"
  },
  "WebPush": {
    "Subject": "mailto:notifications@goisland.example",
    "PublicKey": "replace-with-your-url-safe-vapid-public-key",
    "PrivateKey": "set-with-user-secrets-or-WebPush__PrivateKey"
  },
  "Cors": {
    "FrontendUrl": "http://localhost:5173"
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1"
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
