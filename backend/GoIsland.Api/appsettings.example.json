{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
  },
  "Jwt": {
    "Issuer": "GoIsland.Api",
    "Audience": "GoIsland.Client",
    "Key": "replace-with-a-long-local-secret-key"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "GoogleAuth": {
    "ClientId": "your-client-id.apps.googleusercontent.com"
  },
  "Email": {
    "Provider": "Smtp",
    "FromEmail": "no-reply@goisland.example",
    "FromName": "GoIsland",
    "ResetPasswordUrl": "http://localhost:5173/reset-password"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "smtp-user",
    "Password": "smtp-password"
  },
  "Resend": {
    "ApiKey": "re_replace-with-your-api-key"
  },
  "Cors": {
    "FrontendUrl": "http://localhost:5173"
  },
  "AllowedHosts": "*"
}
